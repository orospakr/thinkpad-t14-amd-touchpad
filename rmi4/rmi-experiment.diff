+/* experiment: raw register dump of every function's control/data space */
+static ssize_t regdump_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct rmi_device *rmi_dev = to_rmi_device(dev);
+	struct rmi_driver_data *data = dev_get_drvdata(&rmi_dev->dev);
+	struct rmi_function *fn;
+	u8 tmp[64];
+	ssize_t n = 0;
+	int i, len, error;
+
+	list_for_each_entry(fn, &data->function_list, node) {
+		len = fn->fd.function_number == 0x12 ? 64 : 16;
+		error = rmi_read_block(rmi_dev, fn->fd.control_base_addr, tmp, len);
+		n += scnprintf(buf + n, PAGE_SIZE - n, "F%02X ctrl@%04x (%d):", fn->fd.function_number,
+			       fn->fd.control_base_addr, error);
+		for (i = 0; i < len; i++)
+			n += scnprintf(buf + n, PAGE_SIZE - n, " %02x", tmp[i]);
+		n += scnprintf(buf + n, PAGE_SIZE - n, "\n");
+		if (fn->fd.function_number == 0x01) {
+			error = rmi_read(rmi_dev, fn->fd.data_base_addr, tmp);
+			n += scnprintf(buf + n, PAGE_SIZE - n, "F01 data0@%04x (%d): %02x\n",
+				       fn->fd.data_base_addr, error, tmp[0]);
+		}
+	}
+	return n;
+}
+static DEVICE_ATTR_RO(regdump);
+
