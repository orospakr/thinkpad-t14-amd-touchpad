 MODULE_PARM_DESC(synaptics_intertouch, "Use a secondary bus for the Synaptics device.");
 
+/* experiment: F01 power management overrides passed to rmi_core via pdata */
+static bool synaptics_rmi_kernel_tracking;
+module_param(synaptics_rmi_kernel_tracking, bool, 0644);
+MODULE_PARM_DESC(synaptics_rmi_kernel_tracking, "Let rmi_core track finger slots by position instead of trusting firmware object order (experiment)");
+static bool synaptics_rmi_nosleep;
+module_param(synaptics_rmi_nosleep, bool, 0644);
+MODULE_PARM_DESC(synaptics_rmi_nosleep, "Set the F01 NoSleep bit on RMI4 companions (experiment)");
+static unsigned char synaptics_rmi_wakeup_threshold, synaptics_rmi_doze_holdoff, synaptics_rmi_doze_interval;
+module_param(synaptics_rmi_wakeup_threshold, byte, 0644);
+module_param(synaptics_rmi_doze_holdoff, byte, 0644);
+module_param(synaptics_rmi_doze_interval, byte, 0644);
+
+/* experiment: send one PS/2 command to the SMBus-attached pad in place.
+ * echo N > /sys/module/psmouse/parameters/synaptics_rmi_ps2cmd
+ * 1 = F5 disable (what psmouse_smbus_reconnect sends on resume), 2 = E8 query sequence
+ * (synaptics_query_hardware), 3 = F6 set defaults, 4 = FF reset (BAT) then F5, 5 = F2 get id,
+ * 6 = synaptics_detect (E6/E8). Never F4.
+ */
+static struct psmouse *synaptics_exp_psmouse;
+static int synaptics_rmi_ps2cmd_set(const char *val, const struct kernel_param *kp)
+{
+	struct psmouse *psmouse = synaptics_exp_psmouse;
+	struct synaptics_device_info info;
+	unsigned int n;
+	int error;
+	u8 param[4];
+
+	if (kstrtouint(val, 0, &n))
+		return -EINVAL;
+	if (!psmouse)
+		return -ENODEV;
+	switch (n) {
+	case 1: error = psmouse_deactivate(psmouse); break;
+	case 2: error = synaptics_query_hardware(psmouse, &info); break;
+	case 3: error = ps2_command(&psmouse->ps2dev, NULL, PSMOUSE_CMD_RESET_DIS); break;
+	case 4: error = psmouse_reset(psmouse); if (!error) error = psmouse_deactivate(psmouse); break;
+	case 5: param[0] = 0xa5; error = ps2_command(&psmouse->ps2dev, param, PSMOUSE_CMD_GETID); break;
+	case 6: error = synaptics_detect(psmouse, false); break;
+	default: return -EINVAL;
+	}
+	psmouse_info(psmouse, "synaptics_rmi_ps2cmd %u -> %d\n", n, error);
+	return error;
+}
+static const struct kernel_param_ops synaptics_rmi_ps2cmd_ops = { .set = synaptics_rmi_ps2cmd_set };
+module_param_cb(synaptics_rmi_ps2cmd, &synaptics_rmi_ps2cmd_ops, NULL, 0200);
+
